{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user account information and subscription status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "subscriptionTier": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "subscriptionTier"]
    },
    "resumes": {
      "title": "Resume",
      "description": "Stores resume content and ATS metrics.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "templateType": { "type": "string" },
        "content": { "type": "object", "description": "JSON structure of the resume" },
        "atsScore": { "type": "number" },
        "version": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "templateType"]
    },
    "certificates": {
      "title": "Certification",
      "description": "Database of available certifications for recommendations.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "industryTags": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" },
        "trendingScore": { "type": "number" },
        "roi": { "type": "string", "description": "Average salary increase" }
      },
      "required": ["name", "provider"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document"
    },
    "/resumes/{resumeId}": {
      "schema": "resumes",
      "description": "Resume document"
    },
    "/certificates/{certId}": {
      "schema": "certificates",
      "description": "Global certificates database"
    }
  }
}
